# Copy to .env and adjust. Never commit .env.

# Where raw files, reports and logs are written
AGENTREADY_DATA_DIR=data
# SQLite database file
AGENTREADY_DB_PATH=data/agentready.db
# Full path to tesseract.exe on Windows (leave empty to use PATH)
TESSERACT_CMD=

# LLM provider keys, used only by the evaluation harness in eval/
# EVAL_LLM_PROVIDER=
# EVAL_LLM_API_KEY=
